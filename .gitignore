# Public source set. Internal working documents and artifacts stay local.
/*
!/.gitignore
!/README.md
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/docs/
/docs/*
!/docs/INSTALL.md
!/docs/BUILD.md
!/docs/PRIVACY.md
!/docs/HISTORY.md
!/docs/RELEASE_NOTES.md
!/docs/PREVIEW_INSTALL.txt
!/docs/MANIFESTO.ru.md
!/docs/assets/
/docs/assets/*
!/docs/assets/README.md
!/docs/assets/spike-glass.png
!/docs/assets/spike-at-rest.png
!/docs/assets/spike-now-playing.png
!/docs/assets/spike-colour-pink.png
!/docs/assets/spike-colour-purple.png
!/docs/assets/spike-colour-orange.png
!/docs/assets/spike-colour-sand.png
!/docs/assets/spike-mirror.png
!/docs/assets/spike-deep-design.png
!/spikes/
/spikes/*
!/spikes/surface-engine/
/spikes/surface-engine/*
!/spikes/surface-engine/Package.swift
!/spikes/surface-engine/build.command
!/spikes/surface-engine/build-media-helper.sh
!/spikes/surface-engine/package-preview.command
!/spikes/surface-engine/Sources/
!/spikes/surface-engine/vendor/

# Preserve backups locally; do not add them to the public source set.
*.bak
.DS_Store
.build/
.build-consumer/
output/
*.dmg
*.mov
*.jpg
*.jpeg
*.gif
*.zip
*.tar.gz
